# apps/api
NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://flashkart:flashkart@localhost:5432/flashkart
REDIS_URL=redis://localhost:6379

# Seconds a Redis reservation is held before the sweeper returns the stock
RESERVATION_TTL_SECONDS=300
# Upper bound on units per single reservation (flash-sale fairness)
MAX_QUANTITY_PER_RESERVATION=5
